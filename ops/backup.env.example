# NEXUS backup configuration. Copy outside the repository and protect it with chmod 600.
# Never commit real values, encryption keys, database URLs, or cloud credentials.
BACKUP_ROOT=/var/backups/nexus
RETENTION_DAYS=30
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nexus_backup
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_DATABASE=nexus
# 32-byte key encoded as base64; generate with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY_B64=replace-with-a-secret
# Optional separate storage. Leave blank to retain encrypted artifacts locally.
S3_URI=
# Optional command to notify on failure, for example a secured internal webhook wrapper.
FAILURE_ALERT_COMMAND=
# Monitor checks that a valid backup is no older than this many hours.
BACKUP_MAX_AGE_HOURS=26
# Optional command invoked by backup-monitor.sh; receives BACKUP_ALERT_MESSAGE.
BACKUP_ALERT_COMMAND=
# Optional command invoked when restore.sh fails; receives RESTORE_ERROR_CODE and RESTORE_ERROR_ARCHIVE.
RESTORE_ALERT_COMMAND=
